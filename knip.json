{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/react-common": {
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.{ts,tsx}", "!src/test/**"]
    },
    "packages/shadcn-ui": {
      "entry": [
        "src/components/ui/*.tsx",
        "src/components/ui-extended/*.tsx",
        "src/hooks/*.{ts,tsx}",
        "src/lib/*.ts",
        ".storybook/{main,preview}.ts",
        "src/**/*.stories.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.{ts,tsx}",
        "!src/**/*.stories.{ts,tsx}",
        "!src/test/**",
        "!src/global.d.ts"
      ],
      "ignoreDependencies": ["tw-animate-css"]
    }
  },
  "ignoreWorkspaces": ["apps/docs"]
}
